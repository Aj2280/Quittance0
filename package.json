{
  "name": "quittance-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stellar invoice system workspace",
  "scripts": {
    "test:shared": "node --test tests/*.test.mjs",
    "test:backend": "npm --prefix backend test",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "test:frontend": "npm --prefix frontend test",
    "test:a11y": "npm --prefix frontend run test:a11y",
    "lint:frontend": "npm --prefix frontend run lint",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "test": "npm run test:shared && npm run test:backend && npm run test:frontend",
    "ci": "npm run typecheck && npm run test && npm run test:a11y"
  }
}
